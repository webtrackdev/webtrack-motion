# Copia este archivo como .env y completa los valores. El .env no se sube a git.

# Solo si corres el worker de la cola de Versio: el mismo valor del secreto MOTION_WORKER_SECRET en Supabase.
MOTION_WORKER_SECRET=

# Voz de los tutoriales (ElevenLabs › Profile › API keys).
ELEVENLABS_API_KEY=

# Leer la tarea de Versio y subir el video con tus permisos (`pnpm video` / `pnpm publish-video`).
# Versio › MCP (Claude) › Nuevo token.
VERSIO_MCP_TOKEN=

# Solo para `pnpm versio` (Versio › Ajustes › API keys).
VERSIO_API_KEY=

# Opcionales
# DEEPGRAM_API_KEY=
# CLAUDE_MODEL=
