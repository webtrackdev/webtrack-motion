{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "baseUrl": ".",
    "paths": {
      "@webtrack/*": [
        "../reactive/src/*"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "remotion.config.ts"
  ]
}
