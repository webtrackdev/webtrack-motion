    "worker": "node scripts/worker.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/bundler": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/google-fonts": "4.0.540",
    "@remotion/paths": "4.0.540",
    "@remotion/shapes": "4.0.540",
    "@remotion/tailwind-v4": "4.0.540",
    "@remotion/three": "4.0.540",
    "@remotion/transitions": "4.0.540",
    "@tailwindcss/postcss": "4.3.3",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.540",
    "tailwindcss": "4.3.3",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/three": "^0.187.0",
    "typescript": "^5.6.0"
